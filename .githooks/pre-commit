#!/bin/sh
# Pre-commit hook: enforce the house writing rules on staged files.
# Enable once per clone with:  git config core.hooksPath .githooks
# Needs Python 3 on PATH. If Python is absent, the check is skipped with a notice
# rather than blocking the commit.

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "house-style hook: python not found on PATH, skipping check." >&2
  exit 0
fi

exec "$PY" tools/check_house_style.py --staged
